# ==============================================================================
# 视频在线预览裁剪 (Video Review & Cutter) - 环境变量配置示例
# ==============================================================================

# 服务基础配置
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# 视频存储与目录路径配置
# VIDEO_ROOTS: 扫描与预览的源视频根目录列表，多个路径之间使用分号 (;) 或英文逗号 (,) 分隔
VIDEO_ROOTS=/media/videos;/mnt/nas/videos

# ARCHIVE_DIR: 审核保留/裁剪后保留的目标归档目录
ARCHIVE_DIR=/media/archive

# DISCARDED_DIR: 废弃/不合格视频的隔离目录
DISCARDED_DIR=/media/discarded

# 数据库配置 (SQLite 占位)
DATABASE_URL=sqlite:///./data/video_review.db

# FFmpeg 路径配置 (可填写系统可执行文件名称或完整路径)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# 前端连接后端 API 地址 (Vite 环境变量)
VITE_API_BASE_URL=http://localhost:8000
